# ──────────────────────────────────────────────────────────────────────────────
# signing.properties.template
#
# Copy to signing.properties for LOCAL builds only.
# ❌ NEVER commit signing.properties to git!
#
# For GitHub Actions, set these GitHub Secrets:
#   KEYSTORE_BASE64   → base64 encoded .p12 keystore
#   KEYSTORE_PASSWORD → defaultryoustream
#   KEY_ALIAS         → ryoustream
#   KEY_PASSWORD      → defaultryoustream
# ──────────────────────────────────────────────────────────────────────────────

storeFile=keystore/release.keystore
storePassword=defaultryoustream
keyAlias=ryoustream
keyPassword=defaultryoustream
