<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RyouPlayer" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
    </style>

    <!-- Splash screen theme -->
    <style name="Theme.RyouPlayer.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.RyouPlayer</item>
    </style>

    <!-- Player theme - always dark.
         NOTE: windowLayoutInDisplayCutoutMode is intentionally NOT set here.
         It is applied at runtime in PlayerActivity.applyNotchMode() so the
         "Extend into display cutout" setting in the app actually works.
         Hardcoding shortEdges here overrides the runtime call and makes the
         setting do nothing. -->
    <style name="Theme.RyouPlayer.Player" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
