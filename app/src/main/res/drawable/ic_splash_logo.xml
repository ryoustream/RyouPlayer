<?xml version="1.0" encoding="utf-8"?>
<!--
    Ryou Player — Splash / Adaptive-icon foreground
    ViewBox 108×108 dp (standard adaptive-icon canvas).
    Safe zone = inner 72×72 dp circle (18–90 dp), so all elements live
    inside that circle to avoid clipping on any launcher shape.

    Design: rounded-rect badge in brand blue with a white play chevron.
    This is the FOREGROUND only — background colour is set via
    @color/ic_launcher_background in the adaptive-icon XML and the
    windowSplashScreenBackground attribute.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Badge background — rounded rect, centred in safe zone (20–88 dp) -->
    <path
        android:fillColor="#4A7EC7"
        android:pathData="
            M54,18
            C38,18 20,20 20,36
            L20,72
            C20,88 38,90 54,90
            C70,90 88,88 88,72
            L88,36
            C88,20 70,18 54,18
            Z" />

    <!-- Subtle inner glow ring (semi-transparent white) -->
    <path
        android:fillColor="#1AFFFFFF"
        android:pathData="
            M54,22
            C39,22 24,24 24,38
            L24,70
            C24,84 39,86 54,86
            C69,86 84,84 84,70
            L84,38
            C84,24 69,22 54,22
            Z" />

    <!-- Solid badge on top (masks the glow ring to a thin border) -->
    <path
        android:fillColor="#4A7EC7"
        android:pathData="
            M54,26
            C40,26 28,27.5 28,40
            L28,68
            C28,80.5 40,82 54,82
            C68,82 80,80.5 80,68
            L80,40
            C80,27.5 68,26 54,26
            Z" />

    <!-- Play triangle — white, centred -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M46,39 L46,69 L72,54 Z" />

</vector>
